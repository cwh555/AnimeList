{
  "name": "animelist",
  "version": "1.0.2",
  "description": "An Obsidian plugin for managing anime, manga, and novel lists in Markdown.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --pretty false && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src types --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run community:check && npm run build",
    "test-vault:link": "node scripts/link-test-vault.mjs",
    "release:check": "node scripts/check-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "community:check": "node scripts/check-community-review.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "anime",
    "manga",
    "novel",
    "media-library",
    "markdown"
  ],
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/parser": "8.46.1",
    "@typescript-eslint/types": "8.46.1",
    "@typescript-eslint/utils": "8.46.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.2",
    "eslint-plugin-obsidianmd": "0.4.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "engines": {
    "node": ">=18"
  }
}
