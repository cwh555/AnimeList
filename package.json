{
  "name": "animelist",
  "version": "1.0.2",
  "description": "An Obsidian plugin for managing anime, manga, and novel lists in Markdown.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --pretty false && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm test && npm run community:check && npm run build",
    "test-vault:link": "node scripts/link-test-vault.mjs",
    "release:check": "node scripts/check-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "community:check": "node scripts/check-community-review.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "anime",
    "manga",
    "novel",
    "media-library",
    "markdown"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
